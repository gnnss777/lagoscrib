# lagoscrib — Environment Variables
# Copie para .env.local e preencha. Modelo reaproveitado do app `só`.
# SEM backend configurado (sem DATABASE_URL), o app roda em modo legado
# local (apenas dev). NUNCA commite .env.local.
#
# Banco oficial: Neon Postgres via integração da Vercel (Marketplace).
# A integração injeta DATABASE_URL (pooler) e a direta sozinha — o resto
# vai via `vercel env add` ou dashboard. `vercel env pull .env.local`
# traz tudo para o migrate/seed local.

# Banco de Dados (Neon — pooler p/ runtime; injetada pela integração Vercel)
DATABASE_URL="postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/banco?sslmode=require"

# Conexão direta (sem pooler) — obrigatória p/ migrations Prisma
DIRECT_DATABASE_URL="postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/banco?sslmode=require"

# NextAuth v5 (gerar com: openssl rand -base64 32)
NEXTAUTH_SECRET="seu-secret-aqui"
# No preview da Vercel pode ficar vazia (AUTH_TRUST_HOST cobre host dinâmico).
# Em produção, fixar na URL canônica.
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# SEM DATABASE_URL o login por NextAuth continua funcionando: o authorize valida
# contra APP_USER/APP_PASS e assina a sessão do mesmo jeito (é o que libera as
# rotas /api/*, como o import por link e o sync). Só o NEXTAUTH_SECRET é
# obrigatório nesse modo.
#
# NUNCArenomeie estas duas para NEXT_PUBLIC_*: o prefixo faz o Next.js embutir
# o valor no bundle do cliente, e a senha passa a ser lida por qualquer pessoa
# que abra o site. O AppContext decide se está autenticado pela SESSÃO
# (SessionBridge), nunca comparando senha no browser — por isso nada no
# cliente precisa do valor. Para multiusuário de verdade, suba um Postgres (o
# caminho já está pronto no authorize).
APP_USER=
APP_PASS=

# Origens permitidas p/ métodos unsafe (CSV). Vazio = só localhost:3000 (dev).
ALLOWED_ORIGINS=

# --- Perfil do deploy (qual base de imoveis entra no bundle) ----------------
# next.config.js le esta env e troca o alias "@/lib/base" pelo arquivo do perfil
# declarado em data/coleta/perfis.json. Escolher o MODULO (e nao um ternario com
# process.env) e o que garante que a base do outro perfil nao entre no bundle.
#
#   thais -> lib/data-thais.ts   (Chaves na Mao, 3+ quartos, teto R$ 8.000)
#   ausente -> lib/data.ts       (dono, 2-3 quartos, teto R$ 3.600)
#
# Sem ela o app usa a base do dono, entao o default nao precisa ser escrito.
# NEXT_PUBLIC_ e obrigatorio: o Dashboard e client component. O build imprime
# "[base] perfil=... -> ..." no log, que e como se confere o deploy.
NEXT_PUBLIC_PERFIL=

# Bypass do gate de login no CLIENT: com =1 o Dashboard abre direto, sem digitar
# usu�rio/senha. Login continua dispon�vel ("Sair" no cabe�alho).
# ATEN��O: NEXT_PUBLIC_* � embutido no bundle do cliente. Com a vari�vel ligada
# em produ��o, qualquer pessoa que abrir o site entra direto no Dashboard � a
# API (/api/*) continua exigindo sess�o. Use APENAS em m�quina local; num
# deploy, deixe vazio para o login valer de verdade.
NEXT_PUBLIC_OPEN_ACCESS=
NEXT_PUBLIC_OPEN_ACCESS_USER=local

# --- Sync entre aparelhos (lib/ownerState, /api/owner-state) ---------------
# Sem isso o kanban, os excluídos, as notas e o checklist ficam SÓ no
# localStorage de cada navegador: abrir em outro PC mostra a base inteira como
# se nada tivesse sido mexido. Uso pessoal, documento único.
#
# UPSTASH_REDIS_REST_URL/TOKEN: Upstash (upstash.com → Redis → Database). Uma
# env var cada, sem schema — é o único lugar onde o estado é gravado.
# Sem elas a rota responde 503 (fail closed), mesmo com o login feito.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Chave do documento no Redis. VAZIA/INEXISTENTE = a chave padrão
# "lagoscrib:owner-state:v1", que é onde o estado do dono já está gravado —
# não apague isso daqui por engano, o app abre vazio sem dar erro.
#
# Só o SEGUNDO cliente preenche, com o namespace DELE (ex.: "cliente-b:owner-state:v1").
# Sem isso os dois deploys apontando para o mesmo Redis enxergam o mesmo kanban
# e uma aba anônima de um apaga o estado do outro. Só letras, números e : - _ . /
# Aspas em volta são removidas; valor vazio ou com espaço faz a rota dar 503 em
# vez de cair na chave do dono — por isso a linha abaixo é comentário, e não
# "OWNER_STATE_KEY=".
# OWNER_STATE_KEY=cliente-b:owner-state:v1
#
# Credencial: o cookie de sessão do NextAuth. NÃO existe mais SYNC_TOKEN — o
# dono já faz login para usar o app, então exigir um segundo segredo por
# aparelho só criava atrito sem proteção real.

# Seed do admin inicial (usado por prisma/seed.ts)
SEED_ADMIN_EMAIL="voce@exemplo.com"
SEED_ADMIN_NAME="Gabriel"
SEED_ADMIN_PASSWORD="troque-por-senha-forte"

# Cron de retenção LGPD (server-only)
CRON_SECRET="cron-secret"
# Allowlist de IPs p/ crons (ex.: 76.76.21.0/24). Vazio = exige CRON_SECRET ou sessão ADMIN.
CRON_IP_ALLOWLIST=

# Gate de telefone por horário comercial: REMOVIDO. O telefone é contato
# profissional de imobiliária, público no anúncio de origem, e o app não tem
# gate de leitura (ver docs/ADR-004-telefone-coleta.md).

# Contato do encarregado de privacidade (LGPD art. 41)
PRIVACY_CONTACT_EMAIL="privacidade@exemplo.com"

# --- Lead de telefone (scripts/coleta/backfill-telefone.mjs) ---------------
# Parte dos anúncios do Zap/VivaReal NÃO mostra o telefone direto: o clique
# abre "Informe seus dados para ver o telefone" (Nome / Telefone / E-mail) com
# aceite dos Termos do portal. Preencher esse formulário envia os dados abaixo
# para CADA anunciante, e cada envio vira um lead teu no painel da imobiliária.
#
# Por isso os valores ficam aqui e NÃO no script: `.env.local` é gitignored,
# o script nunca é commitado com dado pessoal dentro.
#
# A flag LEAD_ENABLED é opt-in explícito: sem ela o backfill só coleta o que
# revela direto, mesmo com as três variáveis preenchidas.
LEAD_ENABLED="false"
LEAD_NOME="seu nome"
LEAD_TELEFONE="+5541999999999"
LEAD_EMAIL="seu-email@exemplo.com"

# Envio de e-mail de reset de senha (Resend, server-only). Sem ela, o token
# é apenas logado em dev — configurar antes de abrir registro público.
RESEND_API_KEY=
RESEND_FROM="lagoscrib <contato@exemplo.com>"
